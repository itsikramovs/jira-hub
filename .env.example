# ============================================================
# Переменные окружения (задаются в Cloudflare Pages → Settings → Variables)
# Ничего из этого НЕ попадает в браузер — только в серверные Functions.
# ============================================================

# --- Jira (один аккаунт-админ, доступ ко всем сайтам) ---
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxx          # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITES=acme, foo, bar                     # поддомены или полные хосты через запятую (acme.atlassian.net)

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE=eyJ...                  # service_role key (Settings → API). СЕКРЕТ! только в Functions

# --- Синхронизация / служебное ---
SYNC_SECRET=придумайте-длинную-строку         # защищает /api/sync и /api/setup

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...              # токен от @BotFather
TELEGRAM_WEBHOOK_SECRET=ещё-одна-строка       # произвольный секрет для проверки вебхука

# --- Gemini ---
GEMINI_API_KEY=AIza...                        # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash                 # опционально
